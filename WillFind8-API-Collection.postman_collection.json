	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set baseUrl if not already set",
					"if (!pm.environment.get('baseUrl')) {",
					"    pm.environment.set('baseUrl', 'http://localhost:3000');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-extract access token from login/register responses",
					"if (pm.response.json() && pm.response.json().access_token) {",
					"    pm.environment.set('accessToken', pm.response.json().access_token);",
					"    console.log('Access token saved to environment');",
					"}",
					"",
					"// Auto-extract IDs from responses for chaining requests",
					"if (pm.response.json() && pm.response.json().id) {",
					"    const responseData = pm.response.json();",
					"    ",
					"    // Save ad ID",
					"    if (pm.request.url.path.includes('ads') && !pm.request.url.path.includes('my-ads') && !pm.request.url.path.includes('saved')) {",
					"        pm.environment.set('adId', responseData.id);",
					"    }",
					"    ",
					"    // Save category ID",
					"    if (pm.request.url.path.includes('categories')) {",
					"        pm.environment.set('categoryId', responseData.id);",
					"    }",
					"    ",
					"    // Save chat ID",
					"    if (pm.request.url.path.includes('chat')) {",
					"        pm.environment.set('chatId', responseData.id);",
					"    }",
					"    ",
					"    // Save user ID",
					"    if (pm.request.url.path.includes('users')) {",
					"        pm.environment.set('userId', responseData.id);",
					"    }",
					"}"
				]
			}
		}
	],
